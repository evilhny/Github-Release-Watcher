
<Window x:Class="GitHubReleaseWatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="GitHub Release Watcher"
        Height="760"
        Width="1040"
        MinHeight="620"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D8DDE5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right"
                    Content="Check now"
                    Background="#2563EB"
                    Foreground="White"
                    BorderBrush="#2563EB"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Click="CheckNow_Click"/>

            <StackPanel>
                <TextBlock Text="GitHub Release Watcher"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="#172033"/>

                <TextBlock Text="Watch repositories for new releases without keeping a browser open."
                           Foreground="#687386"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Repositories -->
        <GroupBox Grid.Row="1"
                  Header="Repositories"
                  Background="White">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="Add repository"
                            Click="AddRepository_Click"/>

                    <TextBox x:Name="RepositoryInput"
                             Height="34"
                             Padding="8,5"
                             VerticalContentAlignment="Center"
                             ToolTip="owner/repository or https://github.com/owner/repository"
                             KeyDown="RepositoryInput_KeyDown"/>
                </DockPanel>

                <DataGrid x:Name="RepositoriesGrid"
                          Grid.Row="1"
                          Margin="0,10,0,0"
                          Height="145"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#E3E7ED"
                          ItemsSource="{Binding Repositories}">

                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn
                            Header="Monitor"
                            Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                            Width="70"/>

                        <DataGridTextColumn
                            Header="Repository"
                            Binding="{Binding FullName}"
                            IsReadOnly="True"
                            Width="*"/>

                        <!-- Clickable latest version -->
                        <DataGridTemplateColumn Header="Latest version" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <Hyperlink
                                            NavigateUri="{Binding LatestReleaseUrl}"
                                            RequestNavigate="LatestVersion_RequestNavigate">
                                            <Run Text="{Binding LatestVersion}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Header="Release IDs known"
                            Binding="{Binding KnownReleaseIds.Count}"
                            IsReadOnly="True"
                            Width="115"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,0">
                    <Button Content="Remove selected"
                            Click="RemoveRepository_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Release history and settings -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Release history -->
            <GroupBox Grid.Column="0"
                      Header="Release history"
                      Background="White"
                      Margin="0,0,10,0">

                <DataGrid x:Name="HistoryGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#E3E7ED"
                          MouseDoubleClick="HistoryGrid_MouseDoubleClick">

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Header="Repository"
                            Binding="{Binding Repository}"
                            Width="1.2*"/>

                        <DataGridTextColumn
                            Header="Version"
                            Binding="{Binding TagName}"
                            Width="0.8*"/>

                        <DataGridTextColumn
                            Header="Published"
                            Binding="{Binding PublishedDisplay}"
                            Width="1.15*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Settings -->
            <GroupBox Grid.Column="1"
                      Header="Settings"
                      Background="White"
                      Margin="0">

                <StackPanel>
                    <TextBlock Text="Check interval"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="minutes"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="#687386"/>

                        <TextBox x:Name="IntervalInput"
                                 Text="30"
                                 Width="90"
                                 Height="32"
                                 Padding="7,4"
                                 VerticalContentAlignment="Center"/>

                        <Button Content="Apply"
                                Click="ApplyInterval_Click"/>
                    </DockPanel>

                    <CheckBox x:Name="StartupCheckBox"
                              Content="Run at Windows startup"
                              Margin="0,6"
                              Checked="StartupChanged"
                              Unchecked="StartupChanged"/>

                    <CheckBox x:Name="TrayCheckBox"
                              Content="Minimize to tray when closing"
                              Margin="0,6"
                              IsChecked="True"
                              Checked="SettingChanged"
                              Unchecked="SettingChanged"/>

                    <CheckBox x:Name="NotificationsCheckBox"
                              Content="Show Windows notifications"
                              Margin="0,6"
                              IsChecked="True"
                              Checked="SettingChanged"
                              Unchecked="SettingChanged"/>

                    <CheckBox x:Name="PrereleaseCheckBox"
                              Content="Include prereleases"
                              Margin="0,6"
                              IsChecked="True"
                              Checked="SettingChanged"
                              Unchecked="SettingChanged"/>

                    <Separator Margin="0,14"/>

                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               TextWrapping="Wrap"
                               Foreground="#687386"/>

                    <TextBlock x:Name="LastCheckText"
                               Text="Not checked yet"
                               TextWrapping="Wrap"
                               Foreground="#687386"
                               Margin="0,8,0,0"/>

                    <Button Content="Open selected release"
                            HorizontalAlignment="Left"
                            Margin="0,14,0,0"
                            Click="OpenRelease_Click"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="3"
                   x:Name="FooterText"
                   Margin="2,12,0,0"
                   Foreground="#687386"
                   Text="Ready. Add a public GitHub repository to begin."/>

        <!-- System tray -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="GitHub Release Watcher">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" Click="TrayOpen_Click"/>
                    <MenuItem Header="Check now" Click="CheckNow_Click"/>
                    <MenuItem Header="Pause monitoring" Click="Pause_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
